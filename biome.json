{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"formatter": {
		"enabled": true,
		"lineWidth": 80,
		"indentStyle": "space"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"overrides": [
		{
			"includes": ["**/tests/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					}
				}
			}
		}
	]
}
